        if self.preferred_language.get().strip() == "Español":
            return {
                "main_menu_title": "Menú Principal",
                "name_label": "Tu nombre",
                "project_label": "Nombre del proyecto",
                "open_ide": "Abrir IDE",
                "change_language": "Cambiar idioma",
                "exit": "Salir",
                "window_title": "IDE Gráfico",
                "greeting": "Bienvenido/a",
                "code_label": "Editor de código",
                "output_label": "Salida",
                "run": "Ejecutar",
                "translate": "Ver traducción a Python",
                "clear_code": "Limpiar código",
                "clear_output": "Limpiar salida",
                "close": "Cerrar Ventana",
                "empty_code": "Escribe código antes de ejecutar.",
                "empty_title": "Código vacío",
                "status_ready": "Listo",
                "status_ran": "Código ejecutado",
                "status_translated": "Traducción generada",
                "status_cleared": "Editor limpiado",
                "status_output_cleared": "Salida limpiada",
                "translation_header": "Traducción Python",
                "error_header": "Error",
                "missing_info_title": "Falta información",
                "missing_name": "Ingresa tu nombre antes de continuar.",
                "missing_project": "Ingresa el nombre del proyecto antes de continuar.",
            }
        return {
            "main_menu_title": "Menu Principal",
            "name_label": "Seu nome",
            "project_label": "Nome do projeto",
            "open_ide": "Abrir IDE",
            "change_language": "Trocar idioma",
            "exit": "Sair",
            "window_title": "IDE Gráfico",
            "greeting": "Bem-vindo(a)",
            "code_label": "Editor de código",
            "output_label": "Saída",
            "run": "Executar",
            "translate": "Ver tradução para Python",
            "clear_code": "Limpar código",
            "clear_output": "Limpar saída",
            "close": "Fechar Janela",
            "empty_code": "Digite código antes de executar.",
            "empty_title": "Código vazio",
            "status_ready": "Pronto",
            "status_ran": "Código executado",
            "status_translated": "Tradução gerada",
            "status_cleared": "Editor limpo",
            "status_output_cleared": "Saída limpa",
