        project = self.project_name.get().strip()
        texts = self.get_texts()

        if not name:
            messagebox.showwarning(texts["missing_info_title"], texts["missing_name"])
            self.name_entry.focus_set()
            return

        if not project:
            messagebox.showwarning(texts["missing_info_title"], texts["missing_project"])
            self.project_entry.focus_set()
            return

        if self.graphics_window and self.graphics_window.winfo_exists():
            self.graphics_window.lift()
            self.graphics_window.focus_force()
            return

        theme = self.get_ide_theme()
        style = ttk.Style()
        style.configure("IdeRoot.TFrame", background=theme["main_bg"])
        style.configure("IdeCard.TFrame", background=theme["card_bg"])
        style.configure("IdeHeader.TLabel", background=theme["header_bg"], foreground=theme["header_fg"], font=("Brush Script MT", 18, "bold"))
        style.configure("IdeSection.TLabel", background=theme["card_bg"], foreground=theme["section_fg"], font=("Georgia", 11, "bold"))
        style.configure("IdeBody.TLabel", background=theme["main_bg"], foreground=theme["body_fg"], font=("Georgia", 10))
        style.configure("Ide.TButton", font=("Georgia", 10, "bold"), padding=8, background=theme["button_bg"])
        style.map("Ide.TButton", background=[("active", theme["button_hover"])])
        style.configure("IdeAccessProjects.TButton", font=("Georgia", 9, "bold"), padding=8, background=theme["button_bg"])
        style.map("IdeAccessProjects.TButton", background=[("active", theme["button_hover"])])

