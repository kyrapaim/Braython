    def increase_font_size(self):
        if self.current_font_size < 20:
            self.current_font_size += 1
            self.code_editor.config(font=("Georgia", self.current_font_size))

    def decrease_font_size(self):
        if self.current_font_size > 8:
            self.current_font_size -= 1
            self.code_editor.config(font=("Georgia", self.current_font_size))
            self.line_numbers.config(font=("Georgia", self.current_font_size))

    def update_line_numbers(self):
        """Update line numbers based on code editor content"""
        if not hasattr(self, 'line_numbers'):
            return
        
        num_lines = int(self.code_editor.index(tk.END).split('.')[0])
        line_num_text = '\n'.join(str(i) for i in range(1, num_lines))
        
        self.line_numbers.config(state="normal")
        self.line_numbers.delete("1.0", tk.END)
        self.line_numbers.insert("1.0", line_num_text)
        self.line_numbers.config(state="disabled")

    def on_editor_scroll(self, *args):
        """Handle editor scroll and update line numbers"""
        if hasattr(self, 'line_numbers'):
            self.line_numbers.yview_moveto(args[0])

    def on_scrollbar_scroll(self, *args):
        """Handle scrollbar movement"""
        if hasattr(self, 'code_editor'):
            self.code_editor.yview(*args)
            self.update_line_numbers()

    def setup_syntax_highlighting(self):
        """Configure text tags for syntax highlighting"""
        # Python keywords
        keywords = ["if", "elif", "else", "for", "while", "def", "return", "import", "from", "class", "True", "False", "None"]
        # Braython keywords
        braython_pt = ["se", "senao", "para", "enquanto", "funcao", "retorna", "verdadeiro", "falso", "nulo", "escreva", "deixe", "leia"]
        braython_es = ["si", "sino", "para", "mientras", "funcion", "retorna", "verdadero", "falso", "nulo", "escribe", "deja", "lee"]
        all_keywords = keywords + braython_pt + braython_es
        
        self.code_editor.tag_configure("keyword", foreground="#0066CC", font=("Georgia", self.current_font_size, "bold"))
        self.code_editor.tag_configure("string", foreground="#009900")
        self.code_editor.tag_configure("comment", foreground="#999999", font=("Georgia", self.current_font_size, "italic"))
        
        # Store keywords for highlighting
        self.keywords = all_keywords
        
        # Bind text changes to syntax highlighting and line number updates
        self.code_editor.bind("<KeyRelease>", self.on_code_change)

    def on_code_change(self, event=None):
        """Handle code changes - update both syntax highlighting and line numbers"""
        self.apply_syntax_highlighting(event)
        self.update_line_numbers()

    def apply_syntax_highlighting(self, event=None):
        """Apply syntax highlighting to the text"""
        if not hasattr(self, 'keywords'):
            return
        
        # Remove all existing tags
        self.code_editor.tag_remove("keyword", "1.0", tk.END)
        self.code_editor.tag_remove("string", "1.0", tk.END)
        self.code_editor.tag_remove("comment", "1.0", tk.END)
        
        # Get all text
        content = self.code_editor.get("1.0", tk.END)
        
        # Highlight comments
        for match in re.finditer(r'#.*$', content, re.MULTILINE):
            start_idx = self.code_editor.index(f"1.0 + {match.start()} chars")
            end_idx = self.code_editor.index(f"1.0 + {match.end()} chars")
            self.code_editor.tag_add("comment", start_idx, end_idx)
        
        # Highlight strings
        for match in re.finditer(r'(["\'])(?:(?=(\\?))\2.)*?\1', content):
            start_idx = self.code_editor.index(f"1.0 + {match.start()} chars")
            end_idx = self.code_editor.index(f"1.0 + {match.end()} chars")
            self.code_editor.tag_add("string", start_idx, end_idx)
        
        # Highlight keywords
        for keyword in self.keywords:
            for match in re.finditer(r'\b' + re.escape(keyword) + r'\b', content):
                start_idx = self.code_editor.index(f"1.0 + {match.start()} chars")
                end_idx = self.code_editor.index(f"1.0 + {match.end()} chars")
                self.code_editor.tag_add("keyword", start_idx, end_idx)

    def export_to_py(self):
        """Export compiled Python code to a .py file"""
        texts = self.get_texts()
        code = self.current_source_code()
        if not code.strip():
            messagebox.showwarning(texts["empty_title"], texts["empty_code"])
            return

        language = self.get_language_code()
        try:
            translated = self.compiler.compile(code, language)
            save_path = filedialog.asksaveasfilename(
                defaultextension=".py",
                filetypes=[("Python files", "*.py"), ("All files", "*")]
            )
            if not save_path:
                return

            with open(save_path, 'w', encoding='utf-8') as f:
                f.write(translated)

            messagebox.showinfo("Success", f"Code exported to {save_path}")
            self.status_var.set("Code exported")
        except Exception as exc:
            messagebox.showerror("Error", f"Failed to export: {exc}")

