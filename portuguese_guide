    def get_language_code(self):
        return "es" if self.preferred_language.get().strip() == "Español" else "pt"

    def get_projects_dir(self):
        base_dir = os.path.dirname(os.path.abspath(__file__))
        projects_dir = os.path.join(base_dir, "projects")
        os.makedirs(projects_dir, exist_ok=True)
        return projects_dir

    def sanitize_filename(self, value):
        clean = re.sub(r"[^a-zA-Z0-9_-]+", "_", value.strip())
        clean = clean.strip("_")
        return clean or "project"

    def get_project_path(self, project_name):
        safe_name = self.sanitize_filename(project_name)
        return os.path.join(self.get_projects_dir(), f"{safe_name}.json")

    def list_saved_project_paths(self):
        projects_dir = self.get_projects_dir()
        files = []
        for name in os.listdir(projects_dir):
            if name.lower().endswith(".json"):
                files.append(os.path.join(projects_dir, name))
        files.sort(key=lambda p: os.path.getmtime(p), reverse=True)
        return files

