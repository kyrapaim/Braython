import tkinter as tk
from tkinter import ttk
from tkinter import messagebox
from compiler import Compiler
from io import StringIO
from contextlib import redirect_stdout, redirect_stderr
import traceback


class App:
    def __init__(self, root: tk.Tk):
        self.root = root
        self.root.title("Braython")
        self.root.geometry("560x390")
        self.root.resizable(False, False)

        self.compiler = Compiler()
        self.user_name = tk.StringVar()
        self.project_name = tk.StringVar()
        self.preferred_language = tk.StringVar(value="Português")

        self.graphics_window = None
        self.code_editor = None
        self.output_view = None
        self.status_var = tk.StringVar(value="")

        self.configure_styles()

        self.main_container = ttk.Frame(root, style="Cute.TFrame", padding=20)
        self.main_container.pack(expand=True, fill="both")

        self.show_language_screen()

    def configure_styles(self):
        style = ttk.Style()
        style.theme_use("clam")

        self.root.configure(bg="#FFE9F3")

        style.configure("Cute.TFrame", background="#FFE9F3")
        style.configure("Card.TFrame", background="#FFF7FB")
        style.configure("Title.TLabel", background="#FFF7FB", foreground="#D43F8D", font=("Comic Sans MS", 22, "bold"))
        style.configure("Section.TLabel", background="#FFF7FB", foreground="#6C2A68", font=("Segoe UI", 11, "bold"))
        style.configure("Body.TLabel", background="#FFF7FB", foreground="#5B415B", font=("Segoe UI", 10))
        style.configure("Cute.TButton", font=("Segoe UI", 10, "bold"), padding=8)
        style.map("Cute.TButton", background=[("active", "#FFC7E3")])
        style.configure("Cute.TCombobox", fieldbackground="#FFFFFF")

    def clear_main_container(self):
        for child in self.main_container.winfo_children():
            child.destroy()

    def show_language_screen(self):
        self.clear_main_container()

        card = ttk.Frame(self.main_container, style="Card.TFrame", padding=24)
        card.pack(expand=True, fill="both")

        ttk.Label(card, text="Choose language / Escolha idioma / Elige idioma", style="Title.TLabel").pack(pady=(8, 22))

        buttons = ttk.Frame(card, style="Card.TFrame")
        buttons.pack()

        ttk.Button(
            buttons,
            text="Português",
            style="Cute.TButton",
            command=lambda: self.select_language("Português")
        ).pack(side="left", padx=10, ipadx=12, ipady=10)

        ttk.Button(
            buttons,
            text="Español",
            style="Cute.TButton",
            command=lambda: self.select_language("Español")
        ).pack(side="left", padx=10, ipadx=12, ipady=10)

    def select_language(self, language):
        self.preferred_language.set(language)
        self.show_main_menu()

    def show_main_menu(self):
        self.clear_main_container()
        texts = self.get_texts()

        self.root.title(texts["main_menu_title"])

        card = ttk.Frame(self.main_container, style="Card.TFrame", padding=24)
        card.pack(expand=True, fill="both")

        ttk.Label(card, text=texts["main_menu_title"], style="Title.TLabel").pack(pady=(0, 16))

        form = ttk.Frame(card, style="Card.TFrame")
        form.pack(fill="x", pady=(0, 16))

        ttk.Label(form, text=texts["name_label"], style="Section.TLabel").grid(row=0, column=0, sticky="w")
        self.name_entry = ttk.Entry(form, textvariable=self.user_name, font=("Segoe UI", 11))
        self.name_entry.grid(row=1, column=0, sticky="ew", pady=(4, 12))

        ttk.Label(form, text=texts["project_label"], style="Section.TLabel").grid(row=2, column=0, sticky="w")
        self.project_entry = ttk.Entry(form, textvariable=self.project_name, font=("Segoe UI", 11))
        self.project_entry.grid(row=3, column=0, sticky="ew", pady=(4, 0))

        form.columnconfigure(0, weight=1)

        buttons = ttk.Frame(card, style="Card.TFrame")
        buttons.pack(fill="x")

        ttk.Button(
            buttons,
            text=texts["open_ide"],
            style="Cute.TButton",
            command=self.open_graphics_window
        ).pack(side="left", ipadx=10, ipady=8)

        ttk.Button(
            buttons,
            text=texts["change_language"],
            style="Cute.TButton",
            command=self.show_language_screen
        ).pack(side="left", padx=(10, 0), ipadx=10, ipady=8)

        ttk.Button(
            buttons,
            text=texts["exit"],
            style="Cute.TButton",
            command=self.root.destroy
        ).pack(side="right", ipadx=10, ipady=8)

        self.name_entry.focus_set()

    def get_language_code(self):
        return "es" if self.preferred_language.get().strip() == "Español" else "pt"

