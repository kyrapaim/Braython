            "missing_name": "Digite seu nome antes de continuar.",
            "missing_project": "Digite o nome do projeto antes de continuar.",
        }

    def set_output(self, text):
        self.output_view.config(state="normal")
        self.output_view.delete("1.0", tk.END)
        self.output_view.insert("1.0", text)
        self.output_view.config(state="disabled")

    def open_graphics_window(self):
        name = self.user_name.get().strip()
        project = self.project_name.get().strip()
        texts = self.get_texts()

        if not name:
            messagebox.showwarning(texts["missing_info_title"], texts["missing_name"])
            self.name_entry.focus_set()
            return

        if not project:
            messagebox.showwarning(texts["missing_info_title"], texts["missing_project"])
            self.project_entry.focus_set()
            return

        if self.graphics_window and self.graphics_window.winfo_exists():
            self.graphics_window.lift()
            self.graphics_window.focus_force()
            return

        self.graphics_window = tk.Toplevel(self.root)
        self.graphics_window.configure(bg="#FFF0F7")
        self.graphics_window.title(f"{texts['window_title']} - {project}")
        self.graphics_window.geometry("1020x670")
        self.graphics_window.minsize(760, 500)

        main = ttk.Frame(self.graphics_window, style="Cute.TFrame", padding=12)
        main.pack(expand=True, fill="both")

        top_card = ttk.Frame(main, style="Card.TFrame", padding=10)
        top_card.pack(fill="x", pady=(0, 8))

        header = ttk.Label(
            top_card,
            text=f"{texts['greeting']}, {name} • {project} • {self.preferred_language.get().strip()}",
            background="#FFF7FB",
            foreground="#6C2A68",
            font=("Comic Sans MS", 11, "bold")
        )
        header.pack(anchor="w")

        controls = ttk.Frame(main, style="Cute.TFrame")
        controls.pack(fill="x", pady=(0, 10))

        ttk.Button(controls, text=texts["run"], command=self.run_current_code).pack(side="left")
        ttk.Button(controls, text=texts["translate"], command=self.show_translation).pack(side="left", padx=(8, 0))
        ttk.Button(controls, text=texts["clear_code"], command=self.clear_code).pack(side="left", padx=(8, 0))
        ttk.Button(controls, text=texts["clear_output"], command=self.clear_output).pack(side="left", padx=(8, 0))
        ttk.Button(controls, text=texts["close"], command=self.close_graphics_window).pack(side="right")

        panes = ttk.Panedwindow(main, orient=tk.HORIZONTAL)
        panes.pack(expand=True, fill="both")

        editor_frame = ttk.Frame(panes, style="Card.TFrame", padding=8)
        output_frame = ttk.Frame(panes, style="Card.TFrame", padding=8)
        panes.add(editor_frame, weight=3)
        panes.add(output_frame, weight=2)

        ttk.Label(editor_frame, text=texts["code_label"], style="Section.TLabel").pack(anchor="w")

        editor_scroll_y = ttk.Scrollbar(editor_frame, orient="vertical")
        editor_scroll_x = ttk.Scrollbar(editor_frame, orient="horizontal")
        self.code_editor = tk.Text(
            editor_frame,
            undo=True,
            wrap="none",
            yscrollcommand=editor_scroll_y.set,
            xscrollcommand=editor_scroll_x.set,
            bg="#FFFDF2",
            fg="#3D2C3D",
            insertbackground="#D43F8D",
            relief="flat",
            borderwidth=0,
            font=("Consolas", 11),
            tabs=(36,)
        )
        editor_scroll_y.config(command=self.code_editor.yview)
        editor_scroll_x.config(command=self.code_editor.xview)
        editor_scroll_y.pack(side="right", fill="y")
        editor_scroll_x.pack(side="bottom", fill="x")
        self.code_editor.pack(expand=True, fill="both")

        ttk.Label(output_frame, text=texts["output_label"], style="Section.TLabel").pack(anchor="w")

        output_scroll_y = ttk.Scrollbar(output_frame, orient="vertical")
        self.output_view = tk.Text(
            output_frame,
            wrap="word",
            yscrollcommand=output_scroll_y.set,
            bg="#F3FDFF",
            fg="#234055",
            relief="flat",
            borderwidth=0,
            font=("Consolas", 10),
            state="disabled"
        )
        output_scroll_y.config(command=self.output_view.yview)
        output_scroll_y.pack(side="right", fill="y")
        self.output_view.pack(expand=True, fill="both")

        self.status_var.set(texts["status_ready"])
        ttk.Label(main, textvariable=self.status_var, style="Body.TLabel").pack(anchor="w", pady=(8, 0))

        self.graphics_window.bind("<Control-Return>", lambda _event: self.run_current_code())

        self.graphics_window.protocol("WM_DELETE_WINDOW", self.close_graphics_window)
        self.code_editor.focus_set()

    def current_source_code(self):
        return self.code_editor.get("1.0", tk.END).rstrip()

    def run_current_code(self):
        texts = self.get_texts()
        code = self.current_source_code()
        if not code.strip():
            messagebox.showwarning(texts["empty_title"], texts["empty_code"])
            return

        language = self.get_language_code()
        stdout_buffer = StringIO()
        stderr_buffer = StringIO()

        try:
            python_code = self.compiler.compile(code, language)
            runtime_globals = {}
            with redirect_stdout(stdout_buffer), redirect_stderr(stderr_buffer):
                exec(python_code, runtime_globals)

            output_text = stdout_buffer.getvalue()
            error_text = stderr_buffer.getvalue()
            final_output = output_text if output_text else ""
            if error_text:
                final_output += error_text
            if not final_output.strip():
                final_output = "(sem saída)" if language == "pt" else "(sin salida)"
            self.set_output(final_output)
            self.status_var.set(texts["status_ran"])
        except Exception as exc:
            translated_message = None
            if hasattr(self.compiler, "last_translated") and self.compiler.last_translated:
                translated_message = self.compiler.last_translated
            error_details = traceback.format_exc()
            if translated_message:
                display = f"{texts['error_header']}: {translated_message}\n\n{error_details}"
            else:
                display = f"{texts['error_header']}: {exc}\n\n{error_details}"
            self.set_output(display)
            self.status_var.set(texts["error_header"])

    def show_translation(self):
        texts = self.get_texts()
        code = self.current_source_code()
        if not code.strip():
            messagebox.showwarning(texts["empty_title"], texts["empty_code"])
            return

        language = self.get_language_code()
        try:
            translated = self.compiler.compile(code, language)
            self.set_output(f"{texts['translation_header']}:\n\n{translated}")
            self.status_var.set(texts["status_translated"])
        except Exception as exc:
            self.set_output(f"{texts['error_header']}: {exc}")
            self.status_var.set(texts["error_header"])

    def clear_code(self):
        texts = self.get_texts()
        self.code_editor.delete("1.0", tk.END)
        self.status_var.set(texts["status_cleared"])

    def clear_output(self):
        texts = self.get_texts()
        self.set_output("")
        self.status_var.set(texts["status_output_cleared"])

    def close_graphics_window(self):
        if self.graphics_window and self.graphics_window.winfo_exists():
            self.graphics_window.destroy()
            self.graphics_window = None


if __name__ == "__main__":
    root = tk.Tk()
    App(root)
    root.mainloop()