        # Editor and scrollbars
        editor_scroll_y = ttk.Scrollbar(editor_container, orient="vertical")
        editor_scroll_x = ttk.Scrollbar(editor_frame, orient="horizontal")
        self.code_editor = tk.Text(
            editor_container,
            undo=True,
            wrap="none",
            yscrollcommand=self.on_editor_scroll,
            xscrollcommand=editor_scroll_x.set,
            bg=theme["editor_bg"],
            fg=theme["editor_fg"],
            insertbackground=theme["cursor"],
            relief="flat",
            borderwidth=0,
            font=("Georgia", self.current_font_size),
            tabs=(36,)
        )
        editor_scroll_y.config(command=self.on_scrollbar_scroll)
        editor_scroll_x.config(command=self.code_editor.xview)
        editor_scroll_y.pack(side="right", fill="y")
        self.code_editor.pack(side="left", expand=True, fill="both")
        editor_scroll_x.pack(side="bottom", fill="x")
        
        # Setup syntax highlighting
        self.setup_syntax_highlighting()
        
        # Update line numbers on start
        self.update_line_numbers()

        ttk.Label(output_frame, text=texts["output_label"], style="IdeSection.TLabel").pack(anchor="w")

        output_scroll_y = ttk.Scrollbar(output_frame, orient="vertical")
        self.output_view = tk.Text(
            output_frame,
            wrap="word",
            yscrollcommand=output_scroll_y.set,
            bg=theme["output_bg"],
            fg=theme["output_fg"],
            relief="flat",
            borderwidth=0,
            font=("Georgia", 10),
            state="disabled"
        )
        output_scroll_y.config(command=self.output_view.yview)
        output_scroll_y.pack(side="right", fill="y")
        self.output_view.pack(expand=True, fill="both")

        self.status_var.set(texts["status_ready"])
        ttk.Label(main, textvariable=self.status_var, style="IdeBody.TLabel").pack(anchor="w", pady=(8, 0))

        self.graphics_window.bind("<Control-Return>", lambda _event: self.run_current_code())
        self.graphics_window.bind("<Control-s>", lambda _event: self.save_project())

        self.graphics_window.protocol("WM_DELETE_WINDOW", self.close_graphics_window)
        self.code_editor.focus_set()

    def current_source_code(self):
        return self.code_editor.get("1.0", tk.END).rstrip()

    def save_project(self):
        texts = self.get_texts()
        project = self.project_name.get().strip()
        name = self.user_name.get().strip()
        if not name:
            messagebox.showwarning(texts["missing_info_title"], texts["missing_name"])
            return
        if not project:
            messagebox.showwarning(texts["missing_info_title"], texts["missing_project"])
            return

        code = self.current_source_code() if self.code_editor else ""
        payload = {
            "project_name": project,
            "user_name": name,
            "language": self.get_language_code(),
            "code": code,
        }

        try:
            path = self.get_project_path(project)
            with open(path, "w", encoding="utf-8") as f:
                json.dump(payload, f, ensure_ascii=False, indent=2)
            if self.graphics_window and self.graphics_window.winfo_exists():
                self.status_var.set(texts["status_saved"])
            messagebox.showinfo(texts["project_saved"], f"{texts['project_saved']}: {project}")
        except Exception as exc:
            messagebox.showerror(texts["error_header"], f"{texts['save_failed']}: {exc}")

    def open_project_browser(self):
        texts = self.get_texts()
        project_paths = self.list_saved_project_paths()

        if not project_paths:
            messagebox.showinfo(texts["saved_projects_title"], texts["no_saved_projects"])
            return

        if self.project_browser_window and self.project_browser_window.winfo_exists():
            self.project_browser_window.lift()
            self.project_browser_window.focus_force()
            return

        self.project_browser_window = tk.Toplevel(self.root)
        self.project_browser_window.title(texts["saved_projects_title"])
        self.project_browser_window.geometry("520x360")
        self.project_browser_window.minsize(480, 320)

        main = ttk.Frame(self.project_browser_window, padding=12)
        main.pack(expand=True, fill="both")

        ttk.Label(main, text=texts["saved_projects_title"], style="Section.TLabel").pack(anchor="w", pady=(0, 6))

        list_frame = ttk.Frame(main)
        list_frame.pack(expand=True, fill="both")

        scrollbar = ttk.Scrollbar(list_frame, orient="vertical")
        project_listbox = tk.Listbox(list_frame, font=("Georgia", 10), yscrollcommand=scrollbar.set)
        scrollbar.config(command=project_listbox.yview)
        scrollbar.pack(side="right", fill="y")
        project_listbox.pack(side="left", expand=True, fill="both")

        display_items = []
        for path in project_paths:
            file_name = os.path.splitext(os.path.basename(path))[0]
            display_items.append((file_name, path))
            project_listbox.insert(tk.END, file_name)

        def open_selected_project():
            selected = project_listbox.curselection()
            if not selected:
                messagebox.showwarning(texts["saved_projects_title"], texts["select_project_first"])
                return
            _, selected_path = display_items[selected[0]]
            self.load_project(selected_path)
            if self.project_browser_window and self.project_browser_window.winfo_exists():
                self.project_browser_window.destroy()
                self.project_browser_window = None

        buttons = ttk.Frame(main)
        buttons.pack(fill="x", pady=(8, 0))

        ttk.Button(buttons, text=texts["open_selected_project"], style="Cute.TButton", command=open_selected_project).pack(side="left")
        ttk.Button(buttons, text=texts["cancel"], style="Cute.TButton", command=self.close_project_browser).pack(side="right")

        self.project_browser_window.protocol("WM_DELETE_WINDOW", self.close_project_browser)

    def close_project_browser(self):
        if self.project_browser_window and self.project_browser_window.winfo_exists():
            self.project_browser_window.destroy()
        self.project_browser_window = None

    def load_project(self, project_path):
        try:
            with open(project_path, "r", encoding="utf-8") as f:
                data = json.load(f)

            language = data.get("language", "pt")
            self.preferred_language.set("Español" if language == "es" else "Português")
            texts = self.get_texts()
            self.user_name.set(data.get("user_name", ""))
            loaded_project_name = data.get("project_name") or os.path.splitext(os.path.basename(project_path))[0]
            self.project_name.set(loaded_project_name)
            code = data.get("code", "")

            if self.graphics_window and self.graphics_window.winfo_exists():
                self.close_graphics_window()

            self.open_graphics_window()
            self.code_editor.delete("1.0", tk.END)
            self.code_editor.insert("1.0", code)
            self.status_var.set(texts["status_loaded"])
            messagebox.showinfo(texts["project_loaded"], f"{texts['project_loaded']}: {loaded_project_name}")
        except Exception as exc:
            texts = self.get_texts()
            messagebox.showerror(texts["error_header"], f"{texts['load_failed']}: {exc}")

    def run_current_code(self):
        texts = self.get_texts()
        code = self.current_source_code()
        if not code.strip():
            messagebox.showwarning(texts["empty_title"], texts["empty_code"])
            return

        language = self.get_language_code()
        stdout_buffer = StringIO()
        stderr_buffer = StringIO()

        try:
            python_code = self.compiler.compile(code, language)
            runtime_globals = {}
            # Create a custom input function that uses tkinter dialogs
            def gui_input(prompt=""):
                result = simpledialog.askstring("Input", prompt, parent=self.graphics_window)
                if result is None:
                    raise EOFError("User cancelled input")
                return result
            
            runtime_globals["input"] = gui_input
            with redirect_stdout(stdout_buffer), redirect_stderr(stderr_buffer):
                exec(python_code, runtime_globals)

            output_text = stdout_buffer.getvalue()
            error_text = stderr_buffer.getvalue()
            final_output = output_text if output_text else ""
            if error_text:
                final_output += error_text
            if not final_output.strip():
                final_output = "(sem saída)" if language == "pt" else "(sin salida)"
            self.set_output(final_output)
            self.status_var.set(texts["status_ran"])
        except Exception as exc:
            try:
                translated_message = translate_exception(exc, language)
            except Exception:
                translated_message = None
            error_details = traceback.format_exc()
            if translated_message:
                display = f"{texts['error_header']}: {translated_message}\n\n{error_details}"
            else:
                display = f"{texts['error_header']}: {texts['error_untranslated']}\n\n{exc}\n\n{error_details}"
            self.set_output(display)
            self.status_var.set(texts["error_header"])

    def show_translation(self):
        texts = self.get_texts()
        code = self.current_source_code()
        if not code.strip():
            messagebox.showwarning(texts["empty_title"], texts["empty_code"])
            return

        language = self.get_language_code()
        try:
            translated = self.compiler.compile(code, language)
            self.set_output(f"{texts['translation_header']}:\n\n{translated}")
            self.status_var.set(texts["status_translated"])
        except Exception as exc:
            self.set_output(f"{texts['error_header']}: {exc}")
            self.status_var.set(texts["error_header"])

    def clear_code(self):
        texts = self.get_texts()
        confirm = messagebox.askyesno(
            texts["clear_code_confirm_title"],
            texts["clear_code_confirm_msg"]
        )
        if confirm:
            self.code_editor.delete("1.0", tk.END)
            self.status_var.set(texts["status_cleared"])

    def clear_output(self):
        texts = self.get_texts()
        self.set_output("")
        self.status_var.set(texts["status_output_cleared"])

    def close_graphics_window(self):
        if self.graphics_window and self.graphics_window.winfo_exists():
            self.graphics_window.destroy()
            self.graphics_window = None
        if self.root and self.root.winfo_exists():
            self.root.deiconify()


